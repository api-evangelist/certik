  "info": {
    "_postman_id": "6c211926-2bf1-453e-a853-15159593eba2",
    "name": "CertiK Partner (Skynet) Security Score Token Scan API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "CertiK Partner API (Skynet) exposes CertiK's Web3 security intelligence: the Skynet Security Score API returns comprehensive, multi-metric security scores for blockchain projects, and the Token Scan API returns real-time on-chain security analysis of token contracts across major chains. Access is by API key issued to partners by the CertiK Business Team. This spec was generated by the API Evangelist enrichment pipeline from CertiK's published Partner API documentation; it is not an official CertiK-published OpenAPI.\n\nContact Support:\n Name: CertiK API Support\n Email: APIsupport@certik.com",
      "type": "text/plain"
    }
  }
